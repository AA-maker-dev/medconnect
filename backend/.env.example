# ==================================================
# MedConnect Backend — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ==================================================

# --- App ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Database ---
DATABASE_URL="postgresql://medconnect:medconnect_pw@localhost:5432/medconnect?schema=public"

# --- JWT ---
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER_ME=30d

# --- Password hashing ---
BCRYPT_SALT_ROUNDS=12

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="MedConnect <no-reply@medconnect.app>"

# --- SMS (architecture-ready; plug in a provider later e.g. Twilio/Sparrow SMS) ---
SMS_PROVIDER=none
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=MedConnect

# --- Cloudinary (file storage: avatars, chat media, prescriptions, lab reports) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- eSewa ---
ESEWA_MERCHANT_ID=your_esewa_merchant_id
ESEWA_SECRET_KEY=your_esewa_secret_key
ESEWA_SUCCESS_URL=http://localhost:5173/payment/esewa/success
ESEWA_FAILURE_URL=http://localhost:5173/payment/esewa/failure
ESEWA_GATEWAY_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# --- FonePay ---
FONEPAY_MERCHANT_CODE=your_fonepay_merchant_code
FONEPAY_SECRET_KEY=your_fonepay_secret_key
FONEPAY_GATEWAY_URL=https://dev-clientapi.fonepay.com/api/merchantRequest
FONEPAY_RETURN_URL=http://localhost:5173/payment/fonepay/callback

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# --- Socket.io ---
SOCKET_CORS_ORIGIN=http://localhost:5173
